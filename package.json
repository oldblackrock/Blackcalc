{
	"name": "blackcalc",
	"version": "1.0.0",
	"description": "Inline math and variables for Obsidian notes, like Apple Notes.",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"test": "node esbuild.config.mjs test && node test/run.mjs"
	},
	"keywords": ["obsidian", "plugin", "calculator", "math", "variables"],
	"author": "Mateus Demarchi Germano",
	"license": "MIT",
	"devDependencies": {
		"@codemirror/state": "^6.4.1",
		"@codemirror/view": "^6.26.3",
		"@types/node": "^20.11.0",
		"builtin-modules": "^3.3.0",
		"esbuild": "^0.20.2",
		"obsidian": "latest",
		"tslib": "^2.6.2",
		"typescript": "^5.4.5"
	}
}
